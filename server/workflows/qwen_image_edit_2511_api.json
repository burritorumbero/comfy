{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "qwen_image_edit_2511_bf16.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_2.5_vl_7b.safetensors", "type": "qwen_image", "device": "default" },
    "_meta": { "title": "Load CLIP" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["1", 0], "shift": 3.1 },
    "_meta": { "title": "ModelSamplingAuraFlow" }
  },
  "5": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["4", 0], "strength": 1, "pre_cfg": false },
    "_meta": { "title": "CFGNorm" }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["5", 0],
      "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1
    },
    "_meta": { "title": "Lightning (4 steps)" }
  },
  "7": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["6", 0],
      "lora_name": "anything2real_2601_A_final_patched.safetensors",
      "strength_model": 0.85
    },
    "_meta": { "title": "Option: Realism" }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" },
    "_meta": { "title": "Picture to edit" }
  },
  "9": {
    "class_type": "FluxKontextImageScale",
    "inputs": { "image": ["8", 0] },
    "_meta": { "title": "Scale to a size the model knows" }
  },
  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": { "clip": ["2", 0], "prompt": "{prompt}", "vae": ["3", 0], "image1": ["9", 0] },
    "_meta": { "title": "Edit instruction (positive)" }
  },
  "11": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": { "clip": ["2", 0], "prompt": "", "vae": ["3", 0], "image1": ["9", 0] },
    "_meta": { "title": "Negative" }
  },
  "12": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["10", 0], "reference_latents_method": "index_timestep_zero" },
    "_meta": { "title": "Edit Model Reference Method" }
  },
  "13": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["11", 0], "reference_latents_method": "index_timestep_zero" },
    "_meta": { "title": "Edit Model Reference Method" }
  },
  "14": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["9", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Encode" }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["7", 0],
      "positive": ["12", 0],
      "negative": ["13", 0],
      "latent_image": ["14", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "KSampler" }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["15", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": { "images": ["16", 0], "filename_prefix": "Qwen-Image-Edit" },
    "_meta": { "title": "Save Image" }
  }
}
